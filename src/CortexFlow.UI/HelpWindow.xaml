<Window x:Class="CortexFlow.UI.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📖 Manual do Usuário &amp; Guia de Uso - CortexFlow 4.0" Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📖 Manual do Usuário &amp; Guia de Uso" FontSize="20" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="CortexFlow 4.0 - Transcritor &amp; Extrator Profissional Local (.NET 9 / WinUI 3)" FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ABAS DO MANUAL -->
        <TabControl Grid.Row="1" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0">
            <!-- ABA 1: INÍCIO RÁPIDO -->
            <TabItem Header="🚀 Início Rápido">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Como Usar o CortexFlow em 3 Passos Simples:" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                        <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="1. Adicionar Arquivos ou Pastas de Mídia" FontWeight="Bold" Foreground="#F1F5F9"/>
                                <TextBlock Text="• Arraste qualquer arquivo de vídeo (.mp4, .mkv), áudio (.mp3, .wav), PDF ou imagem em qualquer lugar da janela." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="• Ou clique em '+ Adicionar Arquivos' (Ctrl+O) ou '+ Adicionar Pasta' (Ctrl+F) na barra superior." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="2. Configurar Predefinições de Saída" FontWeight="Bold" Foreground="#F1F5F9"/>
                                <TextBlock Text="• Escolha a Predefinição: Clean (Limpo), AI Ready (para LLMs), NotebookLM, Study Mode ou Time Blocks (Blocos 30s)." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="• Escolha o formato desejado: Markdown (.md), Texto (.txt), JSON (.json) ou PDF (.pdf)." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="3. Iniciar e Visualizar Resultados" FontWeight="Bold" Foreground="#F1F5F9"/>
                                <TextBlock Text="• Clique no botão verde '▶️ Iniciar Transcrição &amp; Extração'." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="• Assim que o arquivo for concluído, clique no botão '👁️ Result' na tabela para abrir o visualizador de texto e timestamps." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 2: PREDEFINIÇÕES & FORMATOS -->
            <TabItem Header="🤖 Predefinições &amp; Formatos">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Modos de Estruturação Explicados:" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                        <TextBlock Text="• Clean (Limpo):" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Gera o texto transcrito divididos em parágrafos legíveis e bem formatados para leitura humana rápida." FontSize="12" Foreground="#94A3B8" Margin="10,2,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="• Time Blocks (Blocos de Tempo 30s):" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Agrupa a fala em marcadores de tempo fixos (### ⏱️ [00:00 - 00:30]), ideal para localização exata em podcasts e aulas." FontSize="12" Foreground="#94A3B8" Margin="10,2,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="• AI Ready (LLMs / ChatGPT / Claude):" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Gera a transcrição pronta para ser copiada em modelos de linguagem com cabeçalho de contexto e linha do tempo." FontSize="12" Foreground="#94A3B8" Margin="10,2,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="• NotebookLM:" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Estrutura otimizada para o Google NotebookLM, organizando fontes de pesquisa e referências." FontSize="12" Foreground="#94A3B8" Margin="10,2,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="• Study Mode (Guia de Estudos):" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock Text="Extrai marcadores temporais estratégicos para revisão e estudo guiado." FontSize="12" Foreground="#94A3B8" Margin="10,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 3: MODELOS WHISPER -->
            <TabItem Header="⚡ Modelos Whisper">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Guia de Desempenho dos Modelos Whisper:" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                        <Grid Margin="0,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- HEADER -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Modelo" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Velocidade" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Recomendação de Uso" FontWeight="Bold" Foreground="#38BDF8"/>

                            <!-- ROW 1: TINY -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="tiny" Foreground="#F1F5F9" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Ultra-Rápido (10x)" Foreground="#10B981" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Testes rápidos, áudios com voz muito limpa" Foreground="#94A3B8" Margin="0,6,0,0"/>

                            <!-- ROW 2: BASE -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="base" Foreground="#F1F5F9" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Rápido (7x)" Foreground="#10B981" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Recomendado para a maioria das aulas e podcasts (Padrão)" Foreground="#94A3B8" Margin="0,6,0,0"/>

                            <!-- ROW 3: SMALL -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="small" Foreground="#F1F5F9" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Equilibrado (4x)" Foreground="#F59E0B" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Alta precisão em português e áudios com ruído moderado" Foreground="#94A3B8" Margin="0,6,0,0"/>

                            <!-- ROW 4: MEDIUM -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="medium" Foreground="#F1F5F9" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Preciso (2x)" Foreground="#F59E0B" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="Excelente fidelidade para termos técnicos e sotaques" Foreground="#94A3B8" Margin="0,6,0,0"/>

                            <!-- ROW 5: LARGE-V3 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="large-v3" Foreground="#F1F5F9" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="Máxima Precisão (1x)" Foreground="#EF4444" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="Qualidade máxima profissional em múltiplos idiomas" Foreground="#94A3B8" Margin="0,6,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 4: ATALHOS DE TECLADO -->
            <TabItem Header="⌨️ Atalhos de Teclado">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Atalhos Práticos:" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                        <TextBlock Text="• Ctrl + O : Selecionar e adicionar arquivos de mídia" FontSize="13" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                        <TextBlock Text="• Ctrl + F : Selecionar pasta inteira para varredura" FontSize="13" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                        <TextBlock Text="• F1       : Abrir este Manual do Usuário" FontSize="13" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                        <TextBlock Text="• Alt + F4 : Sair do CortexFlow" FontSize="13" Foreground="#F1F5F9" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 5: PRIVACIDADE & SEGURANÇA (5S) -->
            <TabItem Header="🛡️ Privacidade &amp; 5S">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Compromisso de Privacidade &amp; Boas Práticas (5S):" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                        <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🔒 100% Offline &amp; Privado" FontWeight="Bold" Foreground="#10B981"/>
                                <TextBlock Text="Todos os seus áudios, vídeos e documentos são processados localmente no seu próprio computador. Nenhum dado é enviado para a nuvem." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#0F172A" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="🌱 Metodologia 5S em Software" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="• Seiri (Utilização): Código limpo sem redundâncias.\n• Seiton (Organização): Estrutura C# modular em camadas.\n• Seiso (Limpeza): Exclusão de arquivos temporários WAV.\n• Seiketsu (Padronização): Contratos de interface e MVVM.\n• Shitsuke (Disciplina): Suíte xUnit automatizada em CI/CD." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- BOTÃO FECHAR -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Entendi &amp; Fechar" Click="Close_Click" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Padding="20,8" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
