<Window x:Class="CortexFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CortexFlow 4.0 - Transcritor &amp; Extrator Profissional Local" Height="840" Width="1220"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Estilo do Cabeçalho do DataGrid para alto contraste estúdio -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Estilo da Menu Bar Nativa e Submenus em Dark Mode -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0EA5E9"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo do Separador no Menu -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: MENU BAR -->
            <RowDefinition Height="Auto"/> <!-- 1: MAIN TOOLBAR -->
            <RowDefinition Height="*"/>    <!-- 2: DATAGRID (85% ÁREA PRINCIPAL) -->
            <RowDefinition Height="Auto"/> <!-- 3: PAINEL DE PREDEFINIÇÕES & FOOTER -->
            <RowDefinition Height="Auto"/> <!-- 4: STATUSBAR INFERIOR -->
        </Grid.RowDefinitions>

        <!-- 0. BARRA DE MENUS SUPERIOR NATIVA -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="➕ Adicionar Arquivos..." Click="SelectFiles_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="📁 Adicionar Pasta Inteira..." Click="SelectFolder_Click" InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem Header="🗑️ Limpar Toda a Fila" Click="ClearQueue_Click"/>
                <Separator/>
                <MenuItem Header="🚪 Sair" Click="ExitMenu_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <MenuItem Header="_Ferramentas">
                <MenuItem Header="⚙️ Configurações Avançadas &amp; Diagnósticos..." Click="OpenSettings_Click"/>
                <MenuItem Header="🧹 Limpar Cache SHA-256..." Click="ClearCacheMenu_Click"/>
            </MenuItem>

            <MenuItem Header="_Exibir">
                <MenuItem Header="👁️ Visualizador de Resultados..." Click="ViewResult_Click"/>
            </MenuItem>

            <MenuItem Header="A_juda">
                <MenuItem Header="📖 Documentação do CortexFlow" Click="DocumentationMenu_Click"/>
                <MenuItem Header="🌐 Repositório GitHub" Click="GitHubMenu_Click"/>
                <Separator/>
                <MenuItem Header="ℹ️ Sobre o CortexFlow" Click="AboutMenu_Click"/>
            </MenuItem>
        </Menu>

        <!-- 1. BARRA DE FERRAMENTAS PRINCIPAL (MAIN ACTION TOOLBAR) -->
        <Border Grid.Row="1" Background="#1E293B" Padding="15,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Adicionar Arquivos..." Click="SelectFiles_Click" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
                    <Button Content="📁 Adicionar Pasta..." Click="SelectFolder_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
                    <Button Content="🗑️ Remover Selecionado" Click="RemoveSelected_Click" Background="#475569" Foreground="White" Padding="12,8" Margin="0,0,10,0" BorderThickness="0"/>
                    <Button Content="⚙️ Configurações" Click="OpenSettings_Click" Background="#334155" Foreground="White" Padding="12,8" Margin="0,0,10,0" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⏹️ Cancelar" Click="CancelQueue_Click" Background="#EF4444" Foreground="White" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
                    <Button Content="▶️ Iniciar Transcrição &amp; Extração" Click="StartQueue_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="20,8" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ÁREA PRINCIPAL: TABELA DE FILA DE MÍDIAS (DATAGRID EXPANDIDO 85%) -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Margin="10,0,10,10" Padding="8">
            <Grid>
                <DataGrid x:Name="QueueDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" SelectionMode="Extended" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="2.5*"/>
                        <DataGridTextColumn Header="Tamanho" Binding="{Binding FileSizeBytes}" Width="0.8*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*"/>
                        <DataGridTemplateColumn Header="Progresso" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Height="14" Margin="4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mensagem / Caminho de Saída" Binding="{Binding ErrorMessage}" Width="2.5*"/>
                        
                        <!-- COLUNA DE AÇÕES INDIVIDUAIS POR LINHA -->
                        <DataGridTemplateColumn Header="Ações" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="👁️ Result" Click="RowViewResult_Click" Tag="{Binding}" Background="#3B82F6" Foreground="White" Padding="6,2" Margin="0,0,4,0" ToolTip="Ver Resultado"/>
                                        <Button Content="❌ Rem" Click="RowRemoveItem_Click" Tag="{Binding}" Background="#EF4444" Foreground="White" Padding="6,2" ToolTip="Remover Item da Fila"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 3. PAINEL DE CONFIGURAÇÕES DE TRANSCRIÇÃO & PASTA DE SAÍDA NO RODAPÉ -->
        <Border Grid.Row="3" Background="#1E293B" Margin="10,0,10,10" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PREDEFINIÇÃO DE ESTRUTURAÇÃO -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Predefinição de Saída (Preset):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox x:Name="StructuringCombo" SelectedIndex="0" Width="160">
                            <ComboBoxItem Content="Clean (Limpo)"/>
                            <ComboBoxItem Content="AI Ready (LLMs)"/>
                            <ComboBoxItem Content="NotebookLM"/>
                            <ComboBoxItem Content="Study Mode"/>
                            <ComboBoxItem Content="Raw (Texto Bruto)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- MODELO WHISPER -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Modelo Whisper:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox x:Name="ModelCombo" SelectedIndex="1" Width="160">
                            <ComboBoxItem Content="tiny (Ultra-Rápido)"/>
                            <ComboBoxItem Content="base (Recomendado)"/>
                            <ComboBoxItem Content="small (Maior Precisão)"/>
                            <ComboBoxItem Content="medium (Alta Precisão)"/>
                            <ComboBoxItem Content="large-v3 (Máxima Precisão)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- IDIOMA -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Idioma Áudio:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox x:Name="LanguageCombo" SelectedIndex="0" Width="130">
                            <ComboBoxItem Content="Português (pt)"/>
                            <ComboBoxItem Content="Inglês (en)"/>
                            <ComboBoxItem Content="Espanhol (es)"/>
                            <ComboBoxItem Content="Auto-Detectar"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- FORMATO DE EXPORTAÇÃO -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Formato Arquivo:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                        <ComboBox x:Name="FormatCombo" SelectedIndex="0" Width="130">
                            <ComboBoxItem Content="Markdown (.md)"/>
                            <ComboBoxItem Content="Texto (.txt)"/>
                            <ComboBoxItem Content="JSON (.json)"/>
                            <ComboBoxItem Content="PDF (.pdf)"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- OPTIONS CHECKBOXES -->
                    <StackPanel VerticalAlignment="Center" Margin="5,0,0,0">
                        <CheckBox x:Name="TranslateCheck" Content="🌐 Traduzir para Português" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,3"/>
                        <CheckBox x:Name="SameFolderCheck" Content="📁 Salvar na pasta do arquivo original" IsChecked="True" Foreground="#F1F5F9" FontSize="11" Checked="SameFolderCheck_Changed" Unchecked="SameFolderCheck_Changed"/>
                    </StackPanel>
                </StackPanel>

                <!-- CAMPO DE PASTA CUSTOMIZADA SE SELECIONADO -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Grid x:Name="CustomFolderGrid" Visibility="Collapsed" Margin="0,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExportPathText" Background="#0F172A" Foreground="White" Padding="5" FontSize="11" IsReadOnly="True" Text="Padrão: Meus Documentos\CortexFlow_Exports"/>
                        <Button Grid.Column="1" Content="📁..." Click="SelectExportFolder_Click" Background="#334155" Foreground="White" Padding="8,4" Margin="5,0,0,0"/>
                    </Grid>

                    <CheckBox x:Name="CacheCheck" Content="Cache SHA-256" IsChecked="True" Foreground="#F1F5F9" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. BARRA DE STATUS INFERIOR (STATUSBAR) -->
        <StatusBar Grid.Row="4" Background="#0F172A" Foreground="#94A3B8" Padding="10,4" FontSize="11">
            <StatusBarItem x:Name="StatusItemCountText" Content="Fila vazia. Arraste mídias ou clique em + Adicionar Arquivos."/>
            <StatusBarItem HorizontalAlignment="Right" x:Name="StatusGpuText" Content="⚡ Processamento Local (Whisper.net Engine) | 🔒 100% Offline"/>
        </StatusBar>
    </Grid>
</Window>
