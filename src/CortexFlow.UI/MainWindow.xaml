<Window x:Class="CortexFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CortexFlow 4.0 - Transcritor &amp; Extrator Profissional Local" Height="820" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.Resources>
        <!-- Estilo do Cabeçalho do DataGrid para garantir alto contraste -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO DA APLICAÇÃO -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ CortexFlow" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    <TextBlock Text="v4.0 (.NET 9 / WinUI 3 Engine)" FontSize="12" Foreground="#94A3B8" Margin="15,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#059669" CornerRadius="12" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="🔒 100% Processamento Local" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <Button Content="⚙️ Avançado &amp; Diagnóstico" Click="OpenSettings_Click" Background="#334155" Foreground="White" Padding="12,6" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BARRA DE FERRAMENTAS ESTILO CONVERSOR DE MÍDIA & PAINEL DE CONFIGURAÇÕES -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- PAINEL DE IMPORTAÇÃO RÁPIDA -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="📁 Seleção &amp; Importação de Mídia" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <Button Content="➕ Adicionar Arquivos..." Click="SelectFiles_Click" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Padding="15,10" Margin="0,0,10,0" BorderThickness="0"/>
                            <Button Content="📁 Adicionar Pasta Inteira..." Click="SelectFolder_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="15,10" Margin="0,0,10,0" BorderThickness="0"/>
                            <Button Content="🗑️ Remover Selecionados" Click="RemoveSelected_Click" Background="#475569" Foreground="White" Padding="12,10" BorderThickness="0"/>
                        </StackPanel>
                        
                        <TextBlock Text="Arraste e solte vídeos (.mp4, .mkv), áudios (.mp3, .wav), PDFs, DOCX ou Imagens em qualquer lugar da janela." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PAINEL DE CONFIGURAÇÕES DE TRANSCRIÇÃO & EXPORTAÇÃO -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="⚙️ Configurações do Job" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Modelo Whisper:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <ComboBox x:Name="ModelCombo" SelectedIndex="1">
                                <ComboBoxItem Content="tiny (Ultra-Rápido)"/>
                                <ComboBoxItem Content="base (Recomendado)"/>
                                <ComboBoxItem Content="small (Maior Precisão)"/>
                                <ComboBoxItem Content="medium (Alta Precisão)"/>
                                <ComboBoxItem Content="large-v3 (Máxima Precisão)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Idioma:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <ComboBox x:Name="LanguageCombo" SelectedIndex="0">
                                <ComboBoxItem Content="Português (pt)"/>
                                <ComboBoxItem Content="Inglês (en)"/>
                                <ComboBoxItem Content="Espanhol (es)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Modo de Saída:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <ComboBox x:Name="StructuringCombo" SelectedIndex="0">
                                <ComboBoxItem Content="Clean (Limpo)"/>
                                <ComboBoxItem Content="AI Ready (LLMs)"/>
                                <ComboBoxItem Content="NotebookLM"/>
                                <ComboBoxItem Content="Study Mode"/>
                                <ComboBoxItem Content="Raw (Texto Bruto)"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                            <TextBlock Text="Formato Arquivo:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                            <ComboBox x:Name="FormatCombo" SelectedIndex="0">
                                <ComboBoxItem Content="Markdown (.md)"/>
                                <ComboBoxItem Content="Texto (.txt)"/>
                                <ComboBoxItem Content="JSON (.json)"/>
                                <ComboBoxItem Content="PDF (.pdf)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- OPÇÕES DE PASTA DE SAÍDA -->
                    <CheckBox x:Name="SameFolderCheck" Content="Salvar na mesma pasta do arquivo de origem" IsChecked="True" Foreground="#F1F5F9" FontSize="11" Margin="0,2,0,5" Checked="SameFolderCheck_Changed" Unchecked="SameFolderCheck_Changed"/>

                    <Grid x:Name="CustomFolderGrid" Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ExportPathText" Background="#0F172A" Foreground="White" Padding="5" FontSize="11" IsReadOnly="True" Text="Padrão: Meus Documentos\CortexFlow_Exports"/>
                        <Button Grid.Column="1" Content="📁..." Click="SelectExportFolder_Click" Background="#334155" Foreground="White" Padding="8,4" Margin="5,0,0,0"/>
                    </Grid>

                    <CheckBox x:Name="CacheCheck" Content="Usar Cache por Conteúdo (SHA-256)" IsChecked="True" Foreground="#F1F5F9" FontSize="11" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- TABELA DE FILA DE TRANSCRIÇÃO (DATA GRID EXPANDIDO) -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="5,0,0,10">
                    <TextBlock Text="📋 Fila de Transcrição e Extração" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="QueueDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="2*"/>
                        <DataGridTextColumn Header="Tamanho" Binding="{Binding FileSizeBytes}" Width="0.8*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*"/>
                        <DataGridTemplateColumn Header="Progresso" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Height="14" Margin="5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mensagem / Caminho" Binding="{Binding ErrorMessage}" Width="2*"/>
                        
                        <!-- COLUNA DE AÇÕES INDIVIDUAIS NA TABELA -->
                        <DataGridTemplateColumn Header="Ações" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="👁️" Click="RowViewResult_Click" Tag="{Binding}" Background="#3B82F6" Foreground="White" Padding="6,2" Margin="0,0,5,0" ToolTip="Ver Resultado"/>
                                        <Button Content="❌" Click="RowRemoveItem_Click" Tag="{Binding}" Background="#EF4444" Foreground="White" Padding="6,2" ToolTip="Remover Item da Fila"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- BARRA DE AÇÕES INFERIOR -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="👁️ Ver Resultado" Click="ViewResult_Click" Background="#3B82F6" Foreground="White" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
            <Button Content="🗑️ Limpar Toda a Fila" Click="ClearQueue_Click" Background="#475569" Foreground="White" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
            <Button Content="⏹️ Cancelar" Click="CancelQueue_Click" Background="#EF4444" Foreground="White" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
            <Button Content="▶️ Iniciar Transcrição &amp; Extração" Click="StartQueue_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="20,8" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
