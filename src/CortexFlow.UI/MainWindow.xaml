<Window x:Class="CortexFlow.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CortexFlow 4.0 - Transcritor &amp; Estúdio Profissional Local" Height="860" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Estilo do Cabeçalho do DataGrid para alto contraste estúdio -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Estilo da Menu Bar Nativa e Submenus em Dark Mode -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#0EA5E9"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#64748B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo do Separador no Menu -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Estilo do TabControl Principal -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: MENU BAR SUPERIOR -->
            <RowDefinition Height="*"/>    <!-- 1: ABAS PRINCIPAIS DO ESTÚDIO -->
            <RowDefinition Height="Auto"/> <!-- 2: STATUSBAR INFERIOR -->
        </Grid.RowDefinitions>

        <!-- 0. BARRA DE MENUS SUPERIOR NATIVA -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="➕ Adicionar Arquivos..." Click="SelectFiles_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="📁 Adicionar Pasta Inteira..." Click="SelectFolder_Click" InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem Header="🗑️ Limpar Toda a Fila" Click="ClearQueue_Click"/>
                <Separator/>
                <MenuItem Header="🚪 Sair" Click="ExitMenu_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            
            <MenuItem Header="_Ferramentas">
                <MenuItem Header="⚙️ Configurações Avançadas &amp; Diagnósticos..." Click="OpenSettings_Click"/>
                <MenuItem Header="🧹 Limpar Cache SHA-256..." Click="ClearCacheMenu_Click"/>
            </MenuItem>

            <MenuItem Header="_Exibir">
                <MenuItem Header="🎬 Ir para Fila de Conversão" Click="SwitchToQueueTab_Click"/>
                <MenuItem Header="👁️ Ir para Player &amp; Resultados" Click="SwitchToPlayerTab_Click"/>
            </MenuItem>

            <MenuItem Header="A_juda">
                <MenuItem Header="📖 Manual do Usuário &amp; Guia (F1)" Click="DocumentationMenu_Click"/>
                <MenuItem Header="🌐 Repositório GitHub" Click="GitHubMenu_Click"/>
                <Separator/>
                <MenuItem Header="ℹ️ Sobre o CortexFlow" Click="AboutMenu_Click"/>
            </MenuItem>
        </Menu>

        <!-- 1. CORPO DA APLICAÇÃO EM ABAS PRINCIPAIS (ESTÚDIO INTEGRADO) -->
        <TabControl Grid.Row="1" x:Name="MainTabControl" Background="#0F172A" Foreground="#F8FAFC" BorderThickness="0" Margin="5,5,5,0">
            
            <!-- ========================================================================================= -->
            <!-- ABA 1: CONVERSÃO & FILA DE PROCESSAMENTO -->
            <!-- ========================================================================================= -->
            <TabItem Header="🎬 1. Conversão &amp; Fila">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- TOOLBAR -->
                        <RowDefinition Height="*"/>    <!-- DATAGRID -->
                        <RowDefinition Height="Auto"/> <!-- PAINEL DE PRESETS -->
                    </Grid.RowDefinitions>

                    <!-- TOOLBAR DE AÇÕES -->
                    <Border Grid.Row="0" Background="#1E293B" Padding="12,8" Margin="0,0,0,8" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="➕ Adicionar Arquivos..." Click="SelectFiles_Click" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Padding="14,7" Margin="0,0,8,0" BorderThickness="0"/>
                                <Button Content="📁 Adicionar Pasta..." Click="SelectFolder_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="14,7" Margin="0,0,8,0" BorderThickness="0"/>
                                <Button Content="🗑️ Remover Selecionado" Click="RemoveSelected_Click" Background="#475569" Foreground="White" Padding="12,7" Margin="0,0,8,0" BorderThickness="0"/>
                                <Button Content="⚙️ Configurações" Click="OpenSettings_Click" Background="#334155" Foreground="White" Padding="12,7" Margin="0,0,8,0" BorderThickness="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⏹️ Cancelar" Click="CancelQueue_Click" Background="#EF4444" Foreground="White" Padding="14,7" Margin="0,0,8,0" BorderThickness="0"/>
                                <Button Content="▶️ Iniciar Transcrição &amp; Extração" Click="StartQueue_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="18,7" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DATAGRID DA FILA (85% DA TELA) -->
                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                        <DataGrid x:Name="QueueDataGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" SelectionMode="Extended" FontSize="12" MouseDoubleClick="QueueDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="2.5*"/>
                                <DataGridTextColumn Header="Tamanho" Binding="{Binding FileSizeBytes}" Width="0.8*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*"/>
                                <DataGridTemplateColumn Header="Progresso" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="1" Height="14" Margin="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Mensagem / Caminho de Saída" Binding="{Binding ErrorMessage}" Width="2.5*"/>
                                
                                <DataGridTemplateColumn Header="Ações" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="👁️ Ver no Player" Click="RowViewInPlayer_Click" Tag="{Binding}" Background="#3B82F6" Foreground="White" FontWeight="Bold" Padding="8,3" Margin="0,0,4,0" ToolTip="Abrir e tocar no Player Sincronizado"/>
                                                <Button Content="❌ Rem" Click="RowRemoveItem_Click" Tag="{Binding}" Background="#EF4444" Foreground="White" Padding="6,3" ToolTip="Remover Item da Fila"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- PAINEL DE PREDEFINIÇÕES NO RODAPÉ -->
                    <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Predefinição de Saída:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="StructuringCombo" SelectedIndex="0" Width="160">
                                        <ComboBoxItem Content="Clean (Limpo)"/>
                                        <ComboBoxItem Content="Time Blocks (Blocos 30s)"/>
                                        <ComboBoxItem Content="AI Ready (LLMs)"/>
                                        <ComboBoxItem Content="NotebookLM"/>
                                        <ComboBoxItem Content="Study Mode"/>
                                        <ComboBoxItem Content="Raw (Texto Bruto)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Modelo Whisper:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="ModelCombo" SelectedIndex="1" Width="150">
                                        <ComboBoxItem Content="tiny (Ultra-Rápido)"/>
                                        <ComboBoxItem Content="base (Recomendado)"/>
                                        <ComboBoxItem Content="small (Maior Precisão)"/>
                                        <ComboBoxItem Content="medium (Alta Precisão)"/>
                                        <ComboBoxItem Content="large-v3 (Máxima Precisão)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Idioma Áudio:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="LanguageCombo" SelectedIndex="0" Width="125">
                                        <ComboBoxItem Content="Português (pt)"/>
                                        <ComboBoxItem Content="Inglês (en)"/>
                                        <ComboBoxItem Content="Espanhol (es)"/>
                                        <ComboBoxItem Content="Auto-Detectar"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Formato Arquivo:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="FormatCombo" SelectedIndex="0" Width="135">
                                        <ComboBoxItem Content="Markdown (.md)"/>
                                        <ComboBoxItem Content="Texto (.txt)"/>
                                        <ComboBoxItem Content="JSON (.json)"/>
                                        <ComboBoxItem Content="PDF (.pdf)"/>
                                        <ComboBoxItem Content="Anki Cards (.csv)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center" Margin="5,0,0,0">
                                    <CheckBox x:Name="TranslateCheck" Content="🌐 Traduzir para Português" Foreground="#38BDF8" FontSize="11" Margin="0,0,0,2"/>
                                    <CheckBox x:Name="DiarizationCheck" Content="👥 Identificar Locutores" Foreground="#F59E0B" FontSize="11" Margin="0,0,0,2" ToolTip="Agrupar falas por locutor [Locutor A], [Locutor B]"/>
                                    <CheckBox x:Name="SameFolderCheck" Content="📁 Salvar na pasta original" IsChecked="True" Foreground="#F1F5F9" FontSize="11" Checked="SameFolderCheck_Changed" Unchecked="SameFolderCheck_Changed"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <Grid x:Name="CustomFolderGrid" Visibility="Collapsed" Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExportPathText" Background="#0F172A" Foreground="White" Padding="4" FontSize="11" IsReadOnly="True" Text="Padrão: Meus Documentos"/>
                                    <Button Grid.Column="1" Content="📁..." Click="SelectExportFolder_Click" Background="#334155" Foreground="White" Padding="8,4" Margin="4,0,0,0"/>
                                </Grid>

                                <CheckBox x:Name="CacheCheck" Content="Cache SHA-256" IsChecked="True" Foreground="#F1F5F9" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================================= -->
            <!-- ABA 2: VISUALIZADOR & PLAYER SINCRONIZADO (ESTÚDIO INTEGRADO - PAINEL ÚNICO LIMPO) -->
            <!-- ========================================================================================= -->
            <TabItem Header="👁️ 2. Visualizador &amp; Player Sincronizado" x:Name="PlayerTab">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- HEADER DA MÍDIA SELECIONADA -->
                        <RowDefinition Height="*"/>    <!-- PAINEL DIVIDIDO (TRANSCRIÇÃO SINCRONIZADA + PLAYER) -->
                    </Grid.RowDefinitions>

                    <!-- HEADER DA MÍDIA SELECIONADA -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock x:Name="PlayerMediaTitle" Text="📄 Nenhuma mídia selecionada na fila" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock x:Name="PlayerMediaSubtitle" Text="Selecione qualquer trecho para copiar (Ctrl+C) ou dê clique duplo para pular o áudio/vídeo." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="ToggleViewBtn" Content="📖 Ver Texto Corrido" Click="ToggleViewBtn_Click" Background="#334155" Foreground="White" Padding="10,6" Margin="0,0,8,0" BorderThickness="0" ToolTip="Alternar para texto corrido formatado em parágrafos"/>
                                <Button x:Name="SyncButton" Content="🎯 Sincronizar com Vídeo" Click="SyncButton_Click" Background="#0284C7" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" BorderThickness="0" ToolTip="Rolar para o trecho falado no momento"/>
                                <Button Content="🦙 Ollama LLM" Click="OllamaSummary_Click" Background="#8B5CF6" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" BorderThickness="0" ToolTip="Gerar resumo executivo via Ollama Local (100% Offline)"/>
                                <Button Content="📋 Copiar Texto" Click="CopyPlayerText_Click" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,8,0" BorderThickness="0"/>
                                <Button Content="📁 Pasta de Saída" Click="OpenExportFolder_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="12,6" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- PAINEL DIVIDIDO: ESQUERDA (TELA ÚNICA DE TRANSCRIÇÃO SINCRONIZADA) + DIREITA (PLAYER INTERATIVO) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ESQUERDA: TRANSCRIÇÃO SINCRONIZADA EM PAINEL ÚNICO COM CTRL+C E SELEÇÃO LIVRE -->
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="6" Padding="6">
                            <Grid>
                                <!-- TELA 1: TABELA SINCRONIZADA DE FALAS (PADRÃO) -->
                                <DataGrid x:Name="PlayerTimestampsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" Foreground="#F8FAFC" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" SelectionMode="Single" SelectionUnit="FullRow" ClipboardCopyMode="ExcludeHeader" MouseDoubleClick="PlayerTimestampsGrid_MouseDoubleClick">
                                    <DataGrid.Resources>
                                        <!-- DESTALHE AZUL VIBRANTE DA LINHA ATIVA -->
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#0284C7"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Início" Binding="{Binding Start, StringFormat=\{0:mm\\:ss\}}" Width="0.8*"/>
                                        <DataGridTextColumn Header="Fim" Binding="{Binding End, StringFormat=\{0:mm\\:ss\}}" Width="0.8*"/>
                                        <DataGridTextColumn Header="Transcrição Sincronizada (Clique duplo pula | Ctrl+C copia)" Binding="{Binding Text}" Width="4.2*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="Padding" Value="4,3"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- TELA 2: TEXTO CORRIDO FORMATADO EM PARÁGRAFOS (OCULTO POR PADRÃO, ALTERNADO VIA BOTÃO) -->
                                <TextBox x:Name="PlayerResultTextBox" Visibility="Collapsed" Background="#0F172A" Foreground="#F8FAFC" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Padding="10"/>
                            </Grid>
                        </Border>

                        <!-- DIVISOR REDIMENSIONÁVEL -->
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#334155" Margin="4,0"/>

                        <!-- DIREITA: PLAYER INTERATIVO COM ARRASTE DE AGULHA FLUIDO (SCRUBBING) -->
                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="PlayerStatusText" Text="🎵 Player Interativo Sincronizado" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                                <!-- MEDIA ELEMENT NATIVO WINDOWS -->
                                <Border Grid.Row="1" Background="#000000" CornerRadius="4">
                                    <MediaElement x:Name="MainMediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaOpened="MainMediaPlayer_MediaOpened" MediaFailed="MainMediaPlayer_MediaFailed"/>
                                </Border>

                                <!-- CONTROLES DO PLAYER COM SLIDER FLUIDO -->
                                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CurrentTimeText" Text="00:00" FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                        
                                        <!-- SLIDER INTERATIVO COM SUPORTE A ARRASTE DE AGULHA FLUIDO -->
                                        <Slider Grid.Column="1" x:Name="TimelineSlider" Minimum="0" Maximum="100" 
                                                PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                                PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                                ValueChanged="TimelineSlider_ValueChanged"/>

                                        <TextBlock Grid.Column="2" x:Name="TotalTimeText" Text="00:00" FontSize="11" Foreground="#94A3B8" Margin="8,0,0,0"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="▶ Reproduzir" Click="PlayMedia_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="0,0,6,0" BorderThickness="0"/>
                                        <Button Content="⏸ Pause" Click="PauseMedia_Click" Background="#F59E0B" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="0,0,6,0" BorderThickness="0"/>
                                        <Button Content="⏹ Parar" Click="StopMedia_Click" Background="#EF4444" Foreground="White" Padding="14,6" BorderThickness="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 2. BARRA DE STATUS INFERIOR (STATUSBAR) -->
        <StatusBar Grid.Row="2" Background="#0F172A" Foreground="#94A3B8" Padding="10,4" FontSize="11">
            <StatusBarItem x:Name="StatusItemCountText" Content="Fila vazia. Arraste mídias ou clique em + Adicionar Arquivos."/>
            <StatusBarItem HorizontalAlignment="Right" x:Name="StatusGpuText" Content="⚡ Processamento Local (Whisper.net Engine) | 🔒 100% Offline"/>
        </StatusBar>
    </Grid>
</Window>
