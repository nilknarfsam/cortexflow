<Window x:Class="CortexFlow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações Avançadas &amp; Diagnósticos - CortexFlow" Height="550" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="⚙️ Configurações Avançadas do Sistema" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock Text="Gerenciamento de Aceleração, Cache e Diagnóstico Técnico" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- CONTEÚDO -->
        <TabControl Grid.Row="1" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0">
            <TabItem Header="⚡ Aceleração &amp; Performance">
                <StackPanel Margin="15">
                    <TextBlock Text="Aceleração de Hardware para Transcrição:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <RadioButton x:Name="GpuRadio" Content="Usar Aceleração por GPU (CUDA / DirectML) - Recomendado" IsChecked="True" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                    <RadioButton x:Name="CpuRadio" Content="Usar Processamento via CPU" Foreground="#F1F5F9" Margin="0,0,0,15"/>

                    <TextBlock Text="🧹 Gerenciamento de Cache:" FontWeight="Bold" Margin="0,10,0,5"/>
                    <TextBlock Text="O cache armazena o hash SHA-256 dos arquivos para evitar reprocessar o mesmo áudio/vídeo." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="🧹 Limpar Todo o Cache de Conteúdo" Click="ClearCache_Click" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="15,8" HorizontalAlignment="Left" BorderThickness="0"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="🔍 Diagnóstico do Ambiente">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="🔍 Executar Verificação de Diagnóstico" Click="RunDiagnostics_Click" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Padding="15,8" HorizontalAlignment="Left" Margin="0,0,0,10" BorderThickness="0"/>

                    <TextBox Grid.Row="1" x:Name="DiagnosticsReportText" Background="#0F172A" Foreground="#38BDF8" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- BOTÃO FECHAR -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Salvar &amp; Fechar" Click="SaveAndClose_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="20,8" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
