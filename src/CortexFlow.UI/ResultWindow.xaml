<Window x:Class="CortexFlow.UI.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualizador &amp; Player Sincronizado - CortexFlow 4.0" Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A" Foreground="#F8FAFC"
        Closed="Window_Closed">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: CABEÇALHO -->
            <RowDefinition Height="*"/>    <!-- 1: ABAS + PLAYER SINCRONIZADO -->
            <RowDefinition Height="Auto"/> <!-- 2: RODAPÉ DE AÇÕES -->
        </Grid.RowDefinitions>

        <!-- 0. CABEÇALHO -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="📄 Resultado do Processamento" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock x:Name="SubtitleText" Text="Visualização estruturada e pronta para IA" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayerStatusText" Text="🎵 Player de Mídia Carregado" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. PAINEL DIVIDIDO: CONTEÚDO (ESQUERDA) + PLAYER SINCRONIZADO (DIREITA) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/> <!-- ABAS DE TRANSCRIÇÃO E TIMESTAMPS -->
                <ColumnDefinition Width="Auto"/>  <!-- SPLITTER DIVISOR -->
                <ColumnDefinition Width="1*"/>    <!-- MEDIA PLAYER SINCRONIZADO -->
            </Grid.ColumnDefinitions>

            <!-- ESQUERDA: ABAS DE TEXTO E LINHA DO TEMPO -->
            <TabControl Grid.Column="0" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0">
                <!-- ABA 1: TRANSCRIÇÃO LIMPA -->
                <TabItem Header="📖 Transcrição / Texto Extraído">
                    <TextBox x:Name="ResultTextBox" Background="#0F172A" Foreground="#F8FAFC" FontSize="13" 
                             TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Margin="8"/>
                </TabItem>

                <!-- ABA 2: LINHA DO TEMPO COM PONTOS DE REPRODUÇÃO -->
                <TabItem Header="⏱️ Linha do Tempo (Timestamps)">
                    <DataGrid x:Name="TimestampsGrid" AutoGenerateColumns="False" IsReadOnly="True" Background="#0F172A" Foreground="#F8FAFC" RowBackground="#1E293B" AlternatingRowBackground="#0F172A" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Início" Binding="{Binding Start, StringFormat=\{0:mm\\:ss\}}" Width="0.8*"/>
                            <DataGridTextColumn Header="Fim" Binding="{Binding End, StringFormat=\{0:mm\\:ss\}}" Width="0.8*"/>
                            <DataGridTextColumn Header="Texto Transcrito" Binding="{Binding Text}" Width="3*"/>
                            
                            <!-- COLUNA DE AÇÃO: TOCAR A PARTIR DAQUI -->
                            <DataGridTemplateColumn Header="Tocar Mídia" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="▶ Pular p/ Ponto" Click="JumpToTimestamp_Click" Tag="{Binding}" Background="#0EA5E9" Foreground="White" Padding="8,3" FontSize="11" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- DIVISOR REDIMENSIONÁVEL -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#334155" Margin="5,0"/>

            <!-- DIREITA: MEDIA PLAYER SINCRONIZADO DA MÍDIA ORIGINAL -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- PLAYER TITLE -->
                        <RowDefinition Height="*"/>    <!-- VIDEO / AUDIO VISUALIZER -->
                        <RowDefinition Height="Auto"/> <!-- CONTROLES DO PLAYER -->
                    </Grid.RowDefinitions>

                    <TextBlock Text="🎵 Reprodução Sincronizada" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>

                    <!-- ELEMENTO DE MÍDIA NATIVO DO WINDOWS -->
                    <Border Grid.Row="1" Background="#000000" CornerRadius="4">
                        <MediaElement x:Name="MediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" MediaOpened="MediaPlayer_MediaOpened" MediaFailed="MediaPlayer_MediaFailed"/>
                    </Border>

                    <!-- PAINEL DE CONTROLES DO PLAYER -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <!-- BARRA DE PROGRESSO DO TEMPO DE ÁUDIO -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Text="00:00" FontSize="11" Foreground="#94A3B8" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" x:Name="TimelineSlider" Minimum="0" Maximum="100" ValueChanged="TimelineSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" x:Name="TotalTimeText" Text="00:00" FontSize="11" Foreground="#94A3B8" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- BOTÕES DE PLAY, PAUSE, STOP -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="▶ Reproduzir" Click="PlayMedia_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,6,0" BorderThickness="0"/>
                            <Button Content="⏸ Pause" Click="PauseMedia_Click" Background="#F59E0B" Foreground="White" FontWeight="Bold" Padding="12,6" Margin="0,0,6,0" BorderThickness="0"/>
                            <Button Content="⏹ Parar" Click="StopMedia_Click" Background="#EF4444" Foreground="White" Padding="12,6" BorderThickness="0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. RODAPÉ DE AÇÕES -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="📋 Copiar Texto" Click="Copy_Click" Background="#0EA5E9" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
            <Button Content="📁 Abrir Pasta de Exportação" Click="OpenFolder_Click" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,10,0" BorderThickness="0"/>
            <Button Content="❌ Fechar" Click="Close_Click" Background="#475569" Foreground="White" Padding="15,8" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
